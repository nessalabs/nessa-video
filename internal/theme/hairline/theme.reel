# Hairline: near-black ground, 1px grey lines, one grey accent.
#
# This is reel's default theme pack. A pack is one file written in the script
# language: tokens set colours, sizes and timings; style sets defaults per
# kind; define blocks draw components from primitives. Copy it with
# `reel theme export hairline`, change what you like, and point a script at
# it with `theme ./themes/hairline`, or start a new pack with
# `extends hairline` and override only what differs.

tokens
  # ground, ink and lines
  bg            #08090A
  panel         #0B0C0E
  ink           #EDEDEF
  hi            #F4F5F7
  ink-2         #9BA0AB
  ink-3         #8A8F98
  ink-dim       #5A5E68
  title-ink     #7D828C
  line-0        #34373F
  line-1        #6A6E7A
  line-2        #D4D7DE
  stroke        1.2
  radius        8

  # type, in design units (the frame's short side is 720)
  design-short-side  720
  size-title    40
  size-p        18
  size-label    13
  size-code     15
  size-box      15
  size-metric   40
  size-math     30
  size-caption  20
  gap           24

  # code
  syntax-plain        #D5D7DE
  syntax-keyword      #B9AEF0
  syntax-type         #8FCFDD
  syntax-function     #E8D3A2
  syntax-string       #A9D8B8
  syntax-number       #E6B08F
  syntax-comment      #6A6E7A
  syntax-punctuation  #8A8F98
  diff-add      #5FD39B
  diff-del      #F2777B

  # tones: {bad:words} in any text, or tone=bad on an element
  tone-bad      #F2777B
  tone-good     #5FD39B
  tone-warn     #E8C26A
  tone-info     #7FB2F0

  # motion, in seconds
  motion-draw     0.6
  motion-fade     0.35
  motion-rise     0.45
  motion-state    0.3
  motion-camera   0.7
  motion-send     0.8
  motion-stagger  0.15
  motion-hold     1.0

style
  *          enter=fade exit=fade state=rest
  edge       enter=draw exit=fade
  arrow      enter=draw exit=fade
  table      flow=live
  aside      gap=20 align=start
  tree       gap=28
  entry      align=stretch
  box        enter=fade
  card       enter=fade
  circle     enter=fade
  decision   enter=fade
  store      enter=fade
  title      enter=rise exit=rise font=sans-600
  label      font=mono color=ink-3
  code       font=mono
  terminal   font=mono
  array      enter=fade
  chart      enter=draw
  timeline   enter=draw
  process/name  font=sans-500 size=16 color=ink
  process/note  color=ink-3

# Components. Parts named with #name can be targeted from scripts, for
# example #api/unit1 or #api/procs.

define laptop
  col #device gap=6
    box #screen w=200 h=132 r=8
    box #base w=256 h=14 r=3
  label #label "{text}"

define phone
  box #screen w=52 h=106 r=10
  label #label "{text}"

define server units=3
  col #units gap=0
    repeat units
      box #unit{i} w=160 h=60
  col #procs gap=8
    slot
  label #label "{text}"

define process note=""
  row gap=12
    circle #dot r=3
    label #name "{text}"
    label #note "{note}"

define db
  store #store
  label #label "{text}"

# Collections. They are built on two primitives: a container with
# flow=live, where a child a later step shows takes no room until then and
# one that leaves gives its room back, the rest gliding; and `arrow`.
# Put items inside; `show #x` adds one where it is written, `leave #x`
# takes one out, and `set #x "9"` changes one in place.

# a value with an arrow to the next, for linked lists and hash chains
define node
  row gap=0 align=center
    box #value w=64 h=48 "{text}"
    arrow #next len=32

# a plain value cell, for queues, stacks and arrays that grow
define cell
  box #value w=64 h=48 "{text}"

# a linked list: head, its nodes, and the null the last one points to
define list head="head"
  row gap=12 align=center
    label #head "{head}"
    row #items flow=live gap=0 align=center
      slot
    label #null "null"

# a queue: items join at the back (written last) and leave from the front
define queue items=0 label=""
  col gap=10 align=center
    row gap=16 align=center
      label #front "front"
      row #items flow=live gap=8 align=center
        repeat items
          box #slot{i} w=64 h=48
        slot
      label #back "back"
    label #label "{label}"

# a stack, last in first out (`stack` is the pile-of-copies shape): an
# open-topped bin that fills from the bottom. Put `block`s inside, the top
# one first; a pushed block is written above the rest.
define lifo label="" depth=232
  col gap=12 align=center
    col #items flow=live gap=4 align=center justify=end sides=left,right,bottom pad=6 h={depth}
      slot
    label #label "{label}"

# a square-cornered block, for stacks and other bins that fill up
define block
  box #value w=140 h=44 r=0 "{text}"

# one bucket of a hash map: its index and the chain of entries in it
define bucket
  row gap=12 align=center
    box #index w=40 h=40 "{text}"
    arrow #to len=24
    row #chain flow=live gap=0 align=center
      slot

# a load balancer in front of a pool of servers; put the servers inside.
# The connector reaches every server, so one added later is joined too.
define balancer label="load balancer"
  row gap=120 align=center
    box #lb w=160 h=56 "{label}"
    col #pool flow=live gap=16 align=start
      slot
  #lb -> #pool>*

# System components. They are built on engine primitives: `status` (a toned
# dot and label with an inline countdown ring), dot meters, `outline=`,
# rounded frames (`sides=all r=12`), `anchor=true` (where connectors meet
# the component) and live lists. Sends that carry `reply=` travel two
# lanes, so a request and its answer never share a line.

# a circuit breaker: its state above (set #cb "Open" tone=bad, play #cb
# for=4s for the countdown), the breaker, and its failures below
define breaker label="Breaker" tone=good limit=3
  col gap=12 align=center
    status #state "{text}" tone={tone}
    box #box "{label}" w=120 h=64 r=12 outline={tone} anchor=true
    row #failures gap=8 align=center
      label #flabel "failures"
      meter #fails "0" max={limit} kind=dots r=4 tone=bad

# a token-bucket rate limiter: a request that spends a token
# (send … spend=#rl) takes one; set #rl/tokens "6" for=3s refills it
define limiter tokens=6 label="Limiter" unit="tokens"
  col #box sides=all r=12 w=150 pad=14 gap=12 align=center anchor=true
    label #label "{label}" font=sans-500 size=15 color=ink
    meter #tokens "{tokens}" max={tokens} kind=dots tone=info unit="{unit}"

# a cache: a titled list of entries with a count. Put `entry`s inside, the
# newest first; show adds one at the top, leave evicts one, move #e first
# moves a hit to the top.
define cache size=3 count=0 label="Cache" depth=120 w=240
  col #box sides=all r=12 w={w} gap=0 align=stretch anchor=true
    row #head justify=between align=center h=40 pad=14
      label #label "{label}" font=sans-500 size=15 color=ink
      label #count "{count} of {size}"
    col #rows flow=live gap=0 h={depth} align=stretch
      slot

# one key and value in a cache
define entry value=""
  row #row justify=between align=center h=40 pad=14 sides=top
    label #key "{text}"
    label #value "{value}" color=ink
