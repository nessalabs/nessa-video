video "Data blocks"
  size 1920x1080  fps 30

scene window
  title "The window closes in on ==target = 14=="
  array #a 1 3 4 6 8 11 15 19 ptr="lo=0 hi=7"
  ptr #a hi=6
  ptr #a hi=5
  ptr #a lo=1
  mark #a cells=1,5
  say "Sorted input lets each comparison discard ==one end=="

scene swap
  clear
  array #s 5 2 9 1
  swap #s 0 3
  swap #s 1 2
  say "Swaps slide cells past each other"

scene flow
  clear
  mermaid #flow
    flowchart LR
      C[Client] --> G[Gateway]
      G --> H{Cache hit?}
      H -- yes --> R[Respond]
      H -- no --> D[(Database)]
      D --> W[Write cache]
      W --> R
  walk #flow C G H D W R
  say "On a miss the request ==falls through to the database=="

scene timing
  clear
  row gap=56 align=center
    timeline #tl
      request A | 4-66 wait | *68-82 200
      request B | 18-66 wait · joins A | *68-82 200
      db load | *8-62 one load for both
      cache | *62-68 write
    chart #c bar
      burst, before, after
      1, 4, 1
      2, 7, 1
      3, 5, 1
      4, 9, 1
  play #tl for=2.5s
  say "Request B ==waits instead of loading=="

scene cost
  clear
  math "T(n) = 2T(n/2) + O(n) \Rightarrow O(n \log n)"
  math "\sum_{i=1}^{n} i = \frac{n(n+1)}{2}"
  say "Maths is typeset by the built-in TeX engine"
